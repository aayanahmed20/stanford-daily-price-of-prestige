# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data - raw inputs are large and must be fetched by the pipeline.
data/raw/*
!data/raw/.gitkeep

# Reproducible artifacts (rebuilt by the pipeline).
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Notebooks (Quarto) render artifacts
notebooks/*.html
notebooks/.quarto/
*.nb.html

# Quarto / IDE
.quarto/
_freeze/
_site/
*_files/
article.html
notebooks/*.html
docs/*.html
*.nb.html
.DS_Store
.idea/
.vscode/

/.quarto/
**/*.quarto_ipynb
